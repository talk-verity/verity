DATABASE_URL=postgresql+psycopg://delphi:talkdelphi@localhost:5433/delphi
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=False
PROJECT_NAME=Delphi
VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
CLERK_DOMAIN=your-clerk-domain.clerk.accounts.dev
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# AI Provider — only one needs to be set; Groq preferred over Gemini
# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini (fallback if Groq not set)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.0-flash

# STT provider: mock, groq, parakeet (local NVIDIA Parakeet via sherpa-onnx)
STT_PROVIDER=parakeet
GROQ_STT_MODEL=whisper-large-v3-turbo
# ParaKeet runs from the bundled local assets (app/voice/parakeet_assets) when blank
PARAKEET_MODEL_DIR=
PARAKEET_NUM_THREADS=4

# TTS provider: mock, edge, vibevoice
TTS_PROVIDER=kokoro
# VibeVoice runs from the bundled local model (app/voice/vibevoice_assets/model) when blank
VIBEVOICE_MODEL=
VIBEVOICE_SPEAKER=en-Carter_man

# Pinecone (vector database for RAG)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1

# Embedding provider: local (default), gemini, mock
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Cloudflare R2 (report storage). If blank, reports are stored on local disk instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=delphi-reports
R2_PUBLIC_BASE_URL=

# Explicit demo mode only; false disables implicit mock providers.
DEMO_MODE=false
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# Optional custom audience claim. A Clerk publishable key is not an audience.
CLERK_AUDIENCE=
CLERK_JWKS_TTL_SECONDS=300
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=120
VOICE_CONCURRENCY=2
