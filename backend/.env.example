DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/verity
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=True
PROJECT_NAME=Verity
VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
CLERK_DOMAIN=your-clerk-domain.clerk.accounts.dev
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# AI Provider — only one needs to be set; Groq preferred over Gemini
# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (fallback if Groq not set)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.0-flash

# STT provider: mock, groq, faster_whisper
STT_PROVIDER=mock
GROQ_STT_MODEL=whisper-large-v3-turbo

# TTS provider: mock, edge
TTS_PROVIDER=mock
